{
  "openapi": "3.0.3",
  "info": {
    "title": "Microservices Monitoring Worker Service",
    "version": "1.0.0",
    "description": "Worker metrics service for health checks and Prometheus scrape output."
  },
  "servers": [
    {
      "url": "/",
      "description": "Same origin as the Swagger UI page"
    },
    {
      "url": "http://localhost:3002",
      "description": "Local port-forward"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Check worker service health",
        "operationId": "getWorkerHealth",
        "tags": ["Health"],
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            }
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Expose Prometheus metrics",
        "operationId": "getWorkerMetrics",
        "tags": ["Metrics"],
        "responses": {
          "200": {
            "description": "Prometheus text exposition metrics",
            "content": {
              "text/plain; version=0.0.4; charset=utf-8": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthStatus": {
        "type": "object",
        "required": ["status", "service"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["ok"]
          },
          "service": {
            "type": "string",
            "enum": ["worker"]
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      }
    }
  }
}
