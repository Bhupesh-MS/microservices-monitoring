        "h": 8,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "id": 7,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "expr": "sum by (type, status) (rate(jobs_processed_total[2m]))",
          "legendFormat": "{{type}} {{status}}"
