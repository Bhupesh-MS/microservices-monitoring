        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, type) (rate(job_processing_time_seconds_bucket[5m])))",
          "legendFormat": "p95 {{type}}"
        },
        {
          "expr": "histogram_quantile(0.50, sum by (le, type) (rate(job_processing_time_seconds_bucket[5m])))",
          "legendFormat": "p50 {{type}}"
        }
      ],
      "title": "Job Processing Latency",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
